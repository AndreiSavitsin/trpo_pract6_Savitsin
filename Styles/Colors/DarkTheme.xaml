<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="AppForeground" Color="#E0E0E0"/>

    <SolidColorBrush x:Key="PrimaryBg" Color="#2B6CB8"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#378CE0"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#1E4E91"/>
    <SolidColorBrush x:Key="PrimaryBorder" Color="#2B6CB8"/>

    <SolidColorBrush x:Key="SecondaryBg" Color="Transparent"/>
    <SolidColorBrush x:Key="SecondaryHover" Color="#333333"/>
    <SolidColorBrush x:Key="SecondaryBorder" Color="#555555"/>

    <SolidColorBrush x:Key="DangerBg" Color="Transparent"/>
    <SolidColorBrush x:Key="DangerHover" Color="#442726"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#FF99A4"/>
    <SolidColorBrush x:Key="DangerText" Color="#FF99A4"/>

</ResourceDictionary>