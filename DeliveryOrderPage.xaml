<Page x:Class="trpo_pract6_Savitsin.DeliveryOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trpo_pract6_Savitsin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DeliveryOrderPage"
      Background="{DynamicResource AppBackground}">
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Margin="5" Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Введите адрес"/>
            <TextBox/>
        </StackPanel>

        <StackPanel Margin="5" Grid.Row="0" Grid.Column="1">
            <TextBlock Text="Выберите способ доставки"/>
            <ComboBox>
                <ComboBoxItem Content="Самовывоз"/>
                <ComboBoxItem Content="Курьер"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Margin="5" Grid.Row="0" Grid.Column="2">
            <TextBlock Text="Выберите способ оплаты"/>
            <ComboBox>
                <ComboBoxItem Content="Карта"/>
                <ComboBoxItem Content="Наличные"/>
            </ComboBox>
        </StackPanel>

        <Button Content="Сменить тему" Style="{StaticResource SecondaryButton}" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top"
                x:Name="ChangeThemeBtn" Click="ChangeThemeBtn_Click"/>

        <StackPanel Margin="5" Grid.Row="1" Grid.Column="0">
            <TextBlock Text="Введите примечание"/>
            <TextBox Style="{StaticResource MultilineTextBox}"/>
        </StackPanel>

        <StackPanel Margin="5" Grid.Row="1" Grid.Column="1">
            <RadioButton Content="Ускоренная доставка"/>
            <RadioButton Content="Медленная доставка"/>
        </StackPanel>

        <StackPanel Margin="5" Grid.Row="1" Grid.Column="2">
            <CheckBox x:Name="Agreement" Content="Пользовательское соглашение" Click="Agreement_Click"/>
            <CheckBox Content="Отправка данных на почту"/>
        </StackPanel>

        <Button x:Name="btnMakeOrder" Style="{StaticResource CheckoutButton}" Grid.Row="2" Grid.Column="0" Content="Заказать" Click="btnMakeOrder_Click"/>
    </Grid>
</Page>
